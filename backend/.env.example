# Conexão com o PostgreSQL (o docker-compose.yml da raiz sobe o banco com estes valores)
DATABASE_URL=postgresql://passe:passe@localhost:5432/passe?schema=public
# Porta em que a API escuta
PORT=3000
# Origem do frontend liberada no CORS
CORS_ORIGIN=http://localhost:5173
# Banco separado usado só por npm run test:integration (é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgresql://passe:passe@localhost:5432/passe_test?schema=public
